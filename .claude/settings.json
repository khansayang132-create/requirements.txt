{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/scripts/headroom.sh setup",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/scripts/agency-setup.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/skills/skills-manager/scripts/skills_manager.py doctor --offline --brief || true",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["headroom", "21st", "chromium"],
  "permissions": {
    "ask": ["mcp__chromium__browser_confirm_action"]
  },
  "env": {
    "MCP_TIMEOUT": "300000"
  }
}
