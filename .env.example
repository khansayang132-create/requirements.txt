TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# OmniRoute (OpenAI-compatible gateway). Takes priority over OPENAI_API_KEY when set.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto

# Optional: Headroom context-compression proxy in front of the gateway (e.g. http://127.0.0.1:8765/v1).
# The bot tries it first and falls back to the direct route if it is not running.
HEADROOM_BASE_URL=

# Optional fallback: direct OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: LLM for the engineering agency's `review` playbook (python -m agency run review).
# Leave empty to reuse the OMNIROUTE_* settings above. With no key at all, that step is BLOCKED.
AGENCY_LLM_API_KEY=
AGENCY_LLM_BASE_URL=
AGENCY_LLM_MODEL=

# Optional: 21st.dev Magic MCP for Claude Code sessions (UI components). Key from https://21st.dev/mcp.
# Claude Code reads it from the environment (not from .env); set it as an environment secret in cloud sessions.
API_KEY_21ST=

# Optional: publish the website running on this phone (bash termux/install.sh site).
# From your free ngrok account (https://dashboard.ngrok.com): the authtoken and your one free fixed domain.
NGROK_AUTHTOKEN=
SITE_DOMAIN=
SITE_PORT=8080
# Password for the published site: username:password (password 8+ characters). Required unless
# SITE_PUBLIC=yes. Give the same value to cloud sessions as the SITE_AUTH environment secret.
SITE_AUTH=
SITE_PUBLIC=
