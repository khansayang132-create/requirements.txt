# Script writing (optional: without a key, pass --script with an approved script file).
# First one found is used.
ANTHROPIC_API_KEY=
APEX_ANTHROPIC_MODEL=claude-sonnet-5-5
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto
# Optional: Headroom proxy in front of the gateway (tried first, direct route if it is down)
HEADROOM_BASE_URL=
# Optional: model for `apex.cli review` (vision); defaults to OMNIROUTE_MODEL
APEX_VISION_MODEL=
OPENAI_API_KEY=

# Narration (optional: without a key, the offline espeak-ng voice is used).
ELEVENLABS_API_KEY=
APEX_VOICE_ID=NPDHDOOQCSyifTJZOe6J
APEX_TTS_MODEL=eleven_multilingual_v2
