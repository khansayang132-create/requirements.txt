 "audio_segments": [
  {
   "idx": 0,
   "emotion": "hopeful",
   "start_s": 0.0,
   "end_s": 4.047,
   "text": "Setiap tetes peluh adalah janji untuk esok yang lebih baik."
  },
  {
   "idx": 1,
   "emotion": "serious",
   "start_s": 4.659,
   "end_s": 8.098,
   "text": "Lihatlah dia, di bawah terik matahari yang membakar."
  },
  {
   "idx": 2,
   "emotion": "sad",
   "start_s": 8.69,
   "end_s": 13.886,
   "text": "Keadaan sungguh berat, beban keluarga terasa begitu nyata."
  },
  {
   "idx": 3,
   "emotion": "vulnerable",
   "start_s": 14.829,
   "end_s": 19.091,
   "text": "Ada malam-malam tanpa tidur, ada keraguan yang menusuk hati."
  },
  {
   "idx": 4,
   "emotion": "frustrated",
   "start_s": 19.931,
   "end_s": 24.121,
   "text": "Rasa marah dan frustrasi sering datang, ingin menyerah saja."
  },
  {
   "idx": 5,
   "emotion": "determined",
   "start_s": 24.675,
   "end_s": 27.79,
   "text": "Tapi kemudian, dia menarik napas dalam."
  },
  {
   "idx": 6,
   "emotion": "nostalgic",
   "start_s": 28.384,
   "end_s": 33.598,
   "text": "Dia ingat wajah mereka, senyum mereka yang selalu menjadi bahan bakarnya."
  },
  {
   "idx": 7,
   "emotion": "powerful",
   "start_s": 34.471,
   "end_s": 37.067,
   "text": "Di situlah kekuatan itu muncul."
  },
  {
   "idx": 8,
   "emotion": "inspirational",
   "start_s": 38.041,
   "end_s": 43.481,
   "text": "Keteguhan sejati bukan tentang tidak pernah jatuh, tapi tentang terus bangkit lagi."
  },
  {
   "idx": 9,
   "emotion": "determined",
   "start_s": 44.365,
   "end_s": 51.427,
   "text": "Ia memilih untuk berjuang, karena cinta tanpa syarat pada keluarga jauh lebih kuat dari badai apapun."
  },
  {
   "idx": 10,
   "emotion": "happy",
   "start_s": 52.012,
   "end_s": 57.178,
   "text": "Senja di ujung harapan itu, justru menjadi awal dari kebanggaan yang tak terhingga."
  }
 ],
