 "audio_segments": [
  {
   "idx": 0,
   "emotion": "hopeful",
   "start_s": 0.0,
   "end_s": 2.695,
   "text": "Setiap tetes peluh adalah janji untuk esok yang lebih baik."
  },
  {
   "idx": 1,
   "emotion": "serious → serious",
   "start_s": 3.155,
   "end_s": 12.449,
   "text": "Lihatlah dia, di bawah terik matahari yang membakar. Keadaan sungguh berat, beban keluarga terasa begitu nyata. Ada malam-malam tanpa tidur, ada keraguan yang menusuk hati."
  },
  {
   "idx": 2,
   "emotion": "angry",
   "start_s": 12.73,
   "end_s": 16.019,
   "text": "Rasa marah dan frustrasi sering datang, ingin menyerah saja."
  },
  {
   "idx": 3,
   "emotion": "serious → serious",
   "start_s": 16.326,
   "end_s": 24.408,
   "text": "Tapi kemudian, dia menarik napas dalam. Dia ingat wajah mereka, senyum mereka yang selalu menjadi bahan bakarnya. Di situlah kekuatan itu muncul."
  },
  {
   "idx": 4,
   "emotion": "determined → hopeful",
   "start_s": 24.737,
   "end_s": 37.848,
   "text": "Keteguhan sejati bukan tentang tidak pernah jatuh, tapi tentang terus bangkit lagi. Ia memilih untuk berjuang, karena cinta tanpa syarat pada keluarga jauh lebih kuat dari badai apapun. Senja di ujung harapan itu, justru menjadi awal dari kebanggaan yang tak terhingga."
  }
 ],
