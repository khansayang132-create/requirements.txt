 "audio_segments": [
  {
   "idx": 0,
   "emotion": "reflective",
   "start_s": 0.0,
   "end_s": 3.223,
   "text": "Setiap malam adalah pengorbanan yang tak terucapkan."
  },
  {
   "idx": 1,
   "emotion": "serious",
   "start_s": 3.847,
   "end_s": 9.823,
   "text": "Ayah itu bekerja keras di bawah lampu remang, demi setiap buku dan cita-cita anaknya."
  },
  {
   "idx": 2,
   "emotion": "compassionate",
   "start_s": 10.345,
   "end_s": 15.063,
   "text": "Ada lelah yang tak terperi, tapi senyum anaknya selalu jadi kekuatan."
  },
  {
   "idx": 3,
   "emotion": "inspirational",
   "start_s": 15.763,
   "end_s": 20.047,
   "text": "Pengorbanan seorang ayah adalah fondasi mimpi anak-anaknya."
  },
  {
   "idx": 4,
   "emotion": "romantic",
   "start_s": 20.873,
   "end_s": 25.013,
   "text": "Lihatlah, di balik lelah itu, ada cinta yang tak pernah padam."
  }
 ],
