# Add keys only for providers you have independently enabled. Nothing here is needed for the free local engine.
RUNWAYML_API_SECRET=
BFL_API_KEY=
ELEVENLABS_API_KEY=
# Kling signs requests with an access key + secret key pair (a single KLING_API_KEY is not enough)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Higgsfield: HF_KEY, or HF_API_KEY + HF_API_SECRET (HIGGSFIELD_API_KEY is accepted as HF_KEY)
HF_KEY=
# ComfyUI Cloud (official comfy-sdk). A local ComfyUI server (COMFYUI_BASE_URL) is not driven yet.
COMFY_API_KEY=
# Spend ceiling per job, in USD
CS_MAX_SPEND_USD=5
