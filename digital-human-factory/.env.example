# Copy to .env (never commit .env). Leave a provider empty to keep it switched off.
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
RUNWAYML_API_SECRET=
DID_API_KEY=
SYNTHESIA_API_KEY=
# Higgsfield uses the signed-in `higgsfield` CLI (higgsfield auth login); no key here.
# Spending is off unless a job is run with --approve-spend AND fits this cap.
DHF_MAX_SPEND_USD=5
DHF_WORKSPACE=.
