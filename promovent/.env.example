# Promovent V2.5 configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets: python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- Core ---------------------------------------------------------------------------------
PROMOVENT_ENV=production                 # production refuses synthetic data and disabled auth
PROMOVENT_MODE=paper                     # observation | signal | paper | assisted_live | autonomous_live
PROMOVENT_ENABLE_LIVE=no                 # must be "yes" for modes assisted_live / autonomous_live
PROMOVENT_SOURCE=live                    # live (production). "synthetic" only for local demos, never production
PROMOVENT_DEV_NO_AUTH=no
PROMOVENT_API_KEYS=                      # "<key 24+ chars>:admin,<key>:trader,<key>:viewer"
PROMOVENT_RISK_PER_TRADE=0.0025          # hard cap 0.02

# --- Database / cache ------------------------------------------------------------------------
POSTGRES_PASSWORD=                       # docker compose builds PROMOVENT_DATABASE_URL from this
# PROMOVENT_DATABASE_URL=postgresql+psycopg://promovent:PASSWORD@host:5432/promovent   # when not using compose
# PROMOVENT_REDIS_URL=redis://host:6379/0

# --- Market data ----------------------------------------------------------------------------
PROMOVENT_EXCHANGE=binance               # data source: binance | bybit | okx | coinbase (REST); binance|bybit|okx (WebSocket)
PROMOVENT_STREAM_SYMBOLS=BTC/USDT,ETH/USDT

# --- Live execution (trade-only keys; NEVER enable withdrawals on these keys) ----------------
PROMOVENT_LIVE_EXCHANGE=binance          # binance | bybit | okx
PROMOVENT_EXCHANGE_TESTNET=yes           # yes = Binance spot testnet / Bybit testnet / OKX demo trading
PROMOVENT_BINANCE_API_KEY=
PROMOVENT_BINANCE_API_SECRET=
PROMOVENT_BYBIT_API_KEY=
PROMOVENT_BYBIT_API_SECRET=
PROMOVENT_OKX_API_KEY=
PROMOVENT_OKX_API_SECRET=
PROMOVENT_OKX_API_PASSPHRASE=

# --- Whale intelligence ----------------------------------------------------------------------
WHALE_ALERT_API_KEY=
ETHERSCAN_API_KEY=
BLOCKCHAIR_API_KEY=                      # optional; without it Blockchair allows a small free quota
PROMOVENT_WATCH_ADDRESSES=               # label:owner_type:0xaddress,...  (addresses YOU verified)

# --- News and sentiment ---------------------------------------------------------------------
CRYPTOPANIC_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=promovent/2.5 (by u/yourname)

# --- Notifications --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls                   # starttls | ssl | none
