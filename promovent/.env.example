# Promovent configuration. Copy to .env; never commit real values.
PROMOVENT_MODE=paper                 # observation | signal | paper | assisted_live | autonomous_live
PROMOVENT_ENABLE_LIVE=no             # live modes refuse to start unless this is "yes" (and live is not implemented yet)
PROMOVENT_SOURCE=live                # live | synthetic (synthetic = labeled demo data)
PROMOVENT_EXCHANGE=binance           # binance | bybit | okx | coinbase
PROMOVENT_RISK_PER_TRADE=0.005       # hard cap 0.02
PROMOVENT_DB=promovent.db            # SQLite file
# Comma-separated "<key 24+ chars>:<viewer|trader|admin>". Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
PROMOVENT_API_KEYS=
PROMOVENT_DEV_NO_AUTH=no             # "yes" disables auth: local development only
