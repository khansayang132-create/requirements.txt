# Copy to .env (gitignored) and fill in. Never commit .env or token.json.

# --- Google OAuth client (REQUIRED for any API call) ---------------------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect used by the local consent flow (desktop clients accept any localhost port).
GOOGLE_REDIRECT_URI=http://localhost:8080/
# Where the authorized token (contains a refresh token) is stored, mode 600. Relative = toolkit root.
GOOGLE_TOKEN_PATH=token.json
# Alternative to ID/SECRET: path to the downloaded client JSON (keep it out of git).
# GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# --- OPTIONAL -------------------------------------------------------------------
# Not used by the toolkit today (Whisper runs locally without a key). Leave empty.
OPENAI_API_KEY=

# --- Behaviour --------------------------------------------------------------------
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_CATEGORY=22
# Safety lock. true = every write is refused even with --confirm. Set false when you are ready.
YOUTUBE_DRY_RUN=true
# Optional override of the Data API daily unit budget if Google granted you more.
# YOUTUBE_DAILY_QUOTA=10000

LOG_LEVEL=INFO
